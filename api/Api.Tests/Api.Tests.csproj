<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
  </ItemGroup>

  <!-- SsoTests: welche Functions infra/ und local.settings.sample.json ohne sso abschalten. -->
  <ItemGroup>
    <None Include="..\..\infra\*.tf" LinkBase="infra" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Api\local.settings.sample.json" Link="local.settings.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
